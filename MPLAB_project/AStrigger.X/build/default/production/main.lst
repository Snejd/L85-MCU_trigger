                      00003  
  00000010            00004 i    EQU         10              ;Delay register #1
  00000011            00005 j    EQU         11              ;Delay register #2
                      00006     ORG 0x0000                   
0000                  00007 INIT
0000   0C9F           00008     MOVLW ~((1<<T0CS)|(1<<NOT_GPPU))
0001   0002           00009     OPTION                       ;Enable GPIO2 and pull-ups
0002   0C0A           00010     MOVLW (1 << GP1) | (1 << GP3)
0003   0006           00011     TRIS GPIO                    ; GP0, GP2 = outputs; GP1, GP3 = inputs
                      00012 ;init fire to 0
                      00013     ;BCF GPIO, GP0               ;reset GP2 (stop fire)
                      00014 ; you know what.. the initial fire cant fire anyway, because the gun is open
                      00015 ; and at least you know the MCU started coretly
                      00016     
                      00017 ; Never ending loop    
0004                  00018 LOOP
0004   09??           00019     CALL CHECK_TRIGGER
0005   09??           00020     CALL CHECK_RESET
0006   0A??           00021     GOTO LOOP
                      00022     
                      00023   
0007                  00024 CHECK_TRIGGER
0007   0606           00025     BTFSC GPIO, GP0             ;Check if GP0 is 0 (trigger is pressed)
0008   0800           00026     RETLW 0
0009   09??           00027     CALL DEBOUNCE_DELAY         ;If pressed check debounce
000A   0606           00028     BTFSC GPIO, GP0             ;Check if GP0 is 0 (trigger is pressed)
000B   0800           00029     RETLW 0
000C   0A??           00030     GOTO FIRE                   ;If still pressed fire one shot
                      00031     
000D                  00032 FIRE
000D   0506           00033     BSF GPIO, GP0               ;Set GP0 (Fire)
000E                  00034 WAIT_FIRE_CMPLT
000E   0666           00035     BTFSC GPIO, GP3             ;Check if GP3 is 0 (reset is pressed)
000F   0A??           00036     GOTO WAIT_FIRE_CMPLT
0010   0406           00037     BCF GPIO, GP0               ;If pressed reset GP0 (stop fire)
                      00038 
0011                  00039 FIRE_CMPLT
0011   0766           00040     BTFSS GPIO, GP3             ;Check if GP3 is 1 (trigger is not pressed)
0012   0A??           00041     GOTO FIRE_CMPLT                      
0013   09??           00042     CALL DEBOUNCE_DELAY         ;If not pressed check debounce
0014   0766           00043     BTFSS GPIO, GP3             ;Check if GP3 is 1 (trigger is not pressed)
